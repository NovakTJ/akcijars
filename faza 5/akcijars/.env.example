# Email (FZ 4.3.2). Podrazumevano se koristi konzolni backend (poruke se
# ispisuju u terminal) pa app radi i bez SMTP-a. Za pravo slanje koristimo
# zajednički Gmail nalog tima — odkomentariši linije ispod i upiši App Password.
# App Password se NE drži u Git-u; uputstvo i lozinka su u SETUP.md (sekcija 4).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=projectvolontech@gmail.com
# EMAIL_HOST_PASSWORD=<app-password-16-karaktera>
